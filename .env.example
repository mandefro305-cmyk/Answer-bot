# Telegram API Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_STRING_SESSION=your_pyrogram_string_session_here

# Target Quiz Bot Username or ID (e.g., BirrForexChallengeBot)
TARGET_QUIZ_BOT=BirrForexChallengeBot

# AI Provider: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI Settings (if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini Settings (if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
